# Documentation-only template; do not load unchanged into a running instance.
# Replace EVERY REPLACE_WITH_* value in a separately protected local env file.
# The binary reads process environment; it does not automatically load this file.
# This is a fresh Node registration for an existing Agent, not an in-place upgrade.
# Use a newly issued, dedicated Agent credential and a new Node ID. Stop/fence the
# old Worker before starting the replacement; never run two Workers on one store.
OPENLINKER_URL=https://REPLACE_WITH_CORE_HOST.invalid
OPENLINKER_AGENT_ID=REPLACE_WITH_EXISTING_AGENT_UUID
OPENLINKER_AGENT_TOKEN=REPLACE_WITH_NEW_DEDICATED_AGENT_TOKEN
OPENLINKER_NODE_ID=REPLACE_WITH_NEW_NODE_UUID

# New SDK identity/journal/spool directory: do not copy or reuse the old DataDir.
# This path must be separate from the retained Claude workspace and session store.
OPENLINKER_AGENT_NODE_DATA_DIR=/REPLACE_WITH_PRIVATE_ROOT/new-node-runtime
OPENLINKER_AGENT_NODE_ADAPTER=claude
OPENLINKER_AGENT_NODE_CAPACITY=1
OPENLINKER_AGENT_NODE_TRANSPORT=auto

# Native Claude bridge, not `openlinker agent serve` or a Plugin command wrapper.
# Review the installed executable and retain the previous Claude workspace and
# session-store paths exactly. These example paths are not applied automatically.
OPENLINKER_AGENT_NODE_CLAUDE_BIN=REPLACE_WITH_CLAUDE_EXECUTABLE
OPENLINKER_AGENT_NODE_CLAUDE_WORKSPACE=/REPLACE_WITH_EXISTING_CLAUDE_WORKSPACE
OPENLINKER_AGENT_NODE_CLAUDE_SESSION_STORE=/REPLACE_WITH_EXISTING_CLAUDE_STATE/sessions.json
# Explicit migration override; the general Node default remains false.
OPENLINKER_AGENT_NODE_CLAUDE_SESSION_REUSE=true
# Codex/Claude default to native session isolation, which runs every conversation
# in a private workspace and cannot keep the retained workspace/session store.
# This template carries the previous unisolated instance forward, so it opts out
# explicitly: the model can then see the workspace's files, git status/history
# and project instructions. Prefer a separate native registration for new Agents.
OPENLINKER_AGENT_NODE_SESSION_ISOLATION=off

# Copy the reviewed previous model, permission mode, and complete JSON tool list
# (including [] if that was the previous list). Do not broaden permissions as part
# of registration. These values are intentionally not guessed from this machine.
# Workspace/session separation is NOT an OS sandbox or a permission boundary.
OPENLINKER_AGENT_NODE_CLAUDE_MODEL=REPLACE_WITH_PREVIOUS_CLAUDE_MODEL
OPENLINKER_AGENT_NODE_CLAUDE_PERMISSION=REPLACE_WITH_PREVIOUS_CLAUDE_PERMISSION
OPENLINKER_AGENT_NODE_CLAUDE_ALLOWED_TOOLS=["REPLACE_WITH_PREVIOUS_ALLOWED_TOOL"]

# Search is on by default (unset or true allows exactly WebSearch and WebFetch on
# top of ALLOWED_TOOLS). Re-registration carries the previous instance forward,
# so this template keeps it explicitly off; switch to true only after review.
OPENLINKER_AGENT_NODE_CLAUDE_WEB_SEARCH=false
